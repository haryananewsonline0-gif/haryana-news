---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getPublishedArticles } from '@/lib/supabase/server';
import { DISTRICT_MAP, HARYANA_DISTRICTS } from '@/constants/districts';

export const prerender = false; // SSR

const { district } = Astro.params;

if (!district) {
  return Astro.redirect('/404');
}

const runtimeEnv = Astro.locals?.runtime?.env;

// Lookup district metadata
const districtInfo = DISTRICT_MAP.get(district.toLowerCase());
const districtNameHi = districtInfo?.nameHi || district;
const districtNameEn = districtInfo?.nameEn || district;

// Query articles for this district
const articles = await getPublishedArticles({
  district: districtNameHi,
  limit: 24,
  runtimeEnv,
});

const isPriority = districtInfo?.isPriorityRegion;
---

<BaseLayout
  title={`${districtNameHi} समाचार (${districtNameEn} News) | हरियाणा न्यूज़`}
  description={`${districtNameHi} शहर, गांव, मंडी भाव, अपराध, मौसम और विकास कार्यों की ताज़ा खबरें सीधे ग्राउंड से।`}
>
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'क्षेत्रीय समाचार', href: '/category/regional' },
        { label: `${districtNameHi} समाचार` },
      ]}
    />

    <!-- District Header -->
    <header class="bg-white rounded-2xl border border-zinc-200/90 p-6 sm:p-8 shadow-xs">
      <div class="space-y-2 max-w-2xl">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-deepgreen/10 text-deepgreen text-xs font-bold uppercase tracking-wider">
            📍 जिला समाचार
          </span>
          {isPriority && (
            <span class="bg-saffron/10 text-saffron text-xs font-bold px-2.5 py-1 rounded-full">
              विशेष कवरेज क्षेत्र
            </span>
          )}
        </div>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-zinc-950 tracking-tight">
          {districtNameHi} की ताज़ा खबरें
        </h1>
        <p class="text-sm text-zinc-600 leading-relaxed">
          {districtNameHi} और आसपास के ग्रामीण अंचल की हर छोटी-बड़ी खबर, प्रशासनिक आदेश, मंडी भाव और जनहित के मुद्दे।
        </p>
      </div>

      <!-- District Switcher -->
      <div class="mt-6 pt-4 border-t border-zinc-100 space-y-2">
        <span class="text-xs font-bold text-zinc-500 block">अन्य जिले चुनें:</span>
        <div class="flex flex-wrap gap-1.5">
          {HARYANA_DISTRICTS.map((d) => (
            <a
              href={`/district/${d.slug}`}
              class={`px-2.5 py-1 rounded-lg text-xs font-semibold transition-colors ${
                d.slug === district.toLowerCase()
                  ? 'bg-deepgreen text-white shadow-xs'
                  : 'bg-zinc-100 text-zinc-700 hover:bg-zinc-200'
              }`}
            >
              {d.nameHi}
            </a>
          ))}
        </div>
      </div>
    </header>

    <!-- Articles Grid -->
    {articles.length > 0 ? (
      <section class="space-y-4">
        <div class="flex items-center justify-between text-xs text-zinc-500">
          <span>{districtNameHi} से {articles.length} समाचार मिले</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {articles.map((art) => (
            <ArticleCard article={art} variant="standard" />
          ))}
        </div>
      </section>
    ) : (
      <section class="bg-white rounded-2xl border border-zinc-200 p-12 text-center space-y-4">
        <div class="w-16 h-16 mx-auto rounded-full bg-deepgreen/10 flex items-center justify-center text-deepgreen text-2xl font-bold">
          📍
        </div>
        <div class="space-y-2 max-w-md mx-auto">
          <h2 class="text-xl font-bold text-zinc-900">{districtNameHi} की नई खबरें जल्द आ रही हैं</h2>
          <p class="text-xs text-zinc-500 leading-relaxed">
            हमारा ऑटोमेशन इंजन हर 2 घंटे में क्षेत्रीय स्लॉट से नई खबरें अपडेट करता है।
          </p>
        </div>
        <a
          href="/"
          class="inline-block px-4 py-2 bg-deepgreen text-white rounded-xl text-xs font-bold hover:bg-deepgreen-600 transition-colors"
        >
          मुख्य पेज पर जाएं →
        </a>
      </section>
    )}
  </div>
</BaseLayout>
