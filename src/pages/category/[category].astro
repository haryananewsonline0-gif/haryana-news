---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getPublishedArticles, getActiveCategories } from '@/lib/supabase/server';

export const prerender = false; // SSR

const { category } = Astro.params;

if (!category) {
  return Astro.redirect('/404');
}

const runtimeEnv = Astro.locals?.runtime?.env;

// Fetch all categories to get category name & description
const categories = await getActiveCategories(runtimeEnv);
const currentCategory = categories.find((c) => c.slug === category);

const categoryName = currentCategory?.name || category;
const categoryDesc =
  currentCategory?.description ||
  `${categoryName} से जुड़ी सभी ताज़ा और महत्वपूर्ण खबरें पढ़ें।`;

// Fetch articles for this category
const articles = await getPublishedArticles({
  category,
  limit: 24,
  runtimeEnv,
});
---

<BaseLayout
  title={`${categoryName} समाचार | हरियाणा न्यूज़`}
  description={categoryDesc}
>
  <div class="space-y-6">
    <Breadcrumbs items={[{ label: categoryName }]} />

    <!-- Category Header -->
    <header class="bg-white rounded-2xl border border-zinc-200/90 p-6 sm:p-8 shadow-xs">
      <div class="space-y-2 max-w-2xl">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-saffron/10 text-saffron text-xs font-bold uppercase tracking-wider">
          <span>श्रेणी</span>
        </div>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-zinc-950 tracking-tight">
          {categoryName} समाचार
        </h1>
        <p class="text-sm text-zinc-600 leading-relaxed">
          {categoryDesc}
        </p>
      </div>

      <!-- Quick category subnav -->
      <div class="mt-6 pt-4 border-t border-zinc-100 flex flex-wrap gap-2">
        {categories.map((c) => (
          <a
            href={`/category/${c.slug}`}
            class={`px-3 py-1 rounded-lg text-xs font-bold transition-colors ${
              c.slug === category
                ? 'bg-saffron text-white shadow-xs'
                : 'bg-zinc-100 text-zinc-700 hover:bg-zinc-200'
            }`}
          >
            {c.name}
          </a>
        ))}
      </div>
    </header>

    <!-- Articles Grid -->
    {articles.length > 0 ? (
      <section class="space-y-4">
        <div class="flex items-center justify-between text-xs text-zinc-500">
          <span>कुल {articles.length} समाचार मिले</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {articles.map((art) => (
            <ArticleCard article={art} variant="standard" />
          ))}
        </div>
      </section>
    ) : (
      <section class="bg-white rounded-2xl border border-zinc-200 p-12 text-center space-y-4">
        <div class="w-16 h-16 mx-auto rounded-full bg-saffron/10 flex items-center justify-center text-saffron text-2xl font-bold">
          📰
        </div>
        <div class="space-y-2 max-w-md mx-auto">
          <h2 class="text-xl font-bold text-zinc-900">{categoryName} में अभी समाचार तैयार हो रहे हैं</h2>
          <p class="text-xs text-zinc-500 leading-relaxed">
            हमारे टाइमटेबल शेड्यूल के अनुसार इस श्रेणी की नवीनतम खबरें जल्द ही प्रकाशित होंगी।
          </p>
        </div>
        <a
          href="/"
          class="inline-block px-4 py-2 bg-saffron text-white rounded-xl text-xs font-bold hover:bg-amber-600 transition-colors"
        >
          होमपेज पर जाएं →
        </a>
      </section>
    )}
  </div>
</BaseLayout>
