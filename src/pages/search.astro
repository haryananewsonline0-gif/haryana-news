---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getServerSupabase } from '@/lib/supabase/server';
import type { Article } from '@/types/database';

export const prerender = false; // SSR

const query = Astro.url.searchParams.get('q')?.trim() || '';
const runtimeEnv = Astro.locals?.runtime?.env;

let searchResults: Article[] = [];
let hasSearched = false;

if (query) {
  hasSearched = true;
  const client = getServerSupabase(runtimeEnv);

  // Search by title or summary
  const { data, error } = await client
    .from('articles')
    .select('*')
    .eq('status', 'published')
    .or(`title.ilike.%${query}%,summary.ilike.%${query}%`)
    .order('published_at', { ascending: false })
    .limit(30);

  if (!error && data) {
    searchResults = data as Article[];
  }
}

const popularTags = [
  'मंडी भाव',
  'सिरसा',
  'मौसम',
  'HSSC',
  'सोना चांदी',
  'हिसार',
  'फतेहाबाद',
  'सरकारी योजनाएं',
];
---

<BaseLayout
  title={query ? `खोज परिणाम: "${query}" | हरियाणा न्यूज़` : 'समाचार खोजें | हरियाणा न्यूज़'}
  description="हरियाणा न्यूज़ पोर्टल पर अपनी पसंद की खबरें, मंडी भाव, सरकारी योजनाएं और जिला समाचार खोजें।"
>
  <div class="space-y-6 max-w-5xl mx-auto">
    <Breadcrumbs items={[{ label: 'सर्च' }]} />

    <!-- Search Header & Input Box -->
    <section class="bg-white rounded-2xl border border-zinc-200/90 p-6 sm:p-8 shadow-xs text-center space-y-4">
      <div class="space-y-2 max-w-xl mx-auto">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-zinc-950">
          हरियाणा न्यूज़ खोजें
        </h1>
        <p class="text-xs sm:text-sm text-zinc-600">
          खबर का शीर्षक, जिला, मंडी भाव या विषय लिखकर सर्च करें
        </p>
      </div>

      <form action="/search" method="GET" class="max-w-2xl mx-auto flex items-center gap-2">
        <div class="relative flex-grow">
          <input
            type="search"
            name="q"
            value={query}
            placeholder="उदा. सिरसा मंडी भाव, बारिश अलर्ट, सीईटी परीक्षा..."
            required
            class="w-full pl-10 pr-4 py-3 bg-zinc-50 border border-zinc-300 rounded-xl text-sm text-zinc-900 focus:bg-white focus:outline-hidden focus:border-saffron focus:ring-2 focus:ring-saffron/20 transition-all"
          />
          <svg
            class="w-5 h-5 text-zinc-400 absolute left-3.5 top-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            />
          </svg>
        </div>
        <button
          type="submit"
          class="px-6 py-3 bg-saffron hover:bg-amber-600 text-white font-bold text-sm rounded-xl shadow-xs transition-colors cursor-pointer"
        >
          खोजें
        </button>
      </form>

      <!-- Popular Quick Searches -->
      <div class="pt-2 flex flex-wrap items-center justify-center gap-2 text-xs">
        <span class="text-zinc-400 font-medium">लोकप्रिय सर्च:</span>
        {popularTags.map((tag) => (
          <a
            href={`/search?q=${encodeURIComponent(tag)}`}
            class="px-2.5 py-1 bg-zinc-100 hover:bg-saffron/10 hover:text-saffron rounded-lg text-zinc-600 transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    </section>

    <!-- Search Results Section -->
    {hasSearched && (
      <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-zinc-200 pb-2 text-sm text-zinc-600">
          <span>
            <strong>"{query}"</strong> के लिए <strong>{searchResults.length}</strong> परिणाम मिले
          </span>
        </div>

        {searchResults.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {searchResults.map((art) => (
              <ArticleCard article={art} variant="standard" />
            ))}
          </div>
        ) : (
          <div class="bg-white rounded-2xl border border-zinc-200 p-12 text-center space-y-3">
            <span class="text-3xl">🔍</span>
            <h3 class="text-base font-bold text-zinc-800">कोई खबर नहीं मिली</h3>
            <p class="text-xs text-zinc-500 max-w-md mx-auto">
              कृपया अन्य शब्दों या किसी जिले के नाम (उदा. सिरसा, फतेहाबाद, मौसम) से पुनः प्रयास करें।
            </p>
          </div>
        )}
      </section>
    )}
  </div>
</BaseLayout>
