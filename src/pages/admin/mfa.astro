---
// ==============================================================================
// Admin 2FA (TOTP) Challenge Page
// Route: /admin/mfa
// ==============================================================================

import '@/styles/global.css';
import { verifyAdminSession } from '@/lib/auth/session';

export const prerender = false;

const runtimeEnv = Astro.locals?.runtime?.env;
const session = await verifyAdminSession(Astro.cookies, runtimeEnv);

if (!session.isAuthenticated || !session.isAdmin) {
  return Astro.redirect('/admin/login');
}

if (session.isMfaVerified) {
  return Astro.redirect('/admin');
}
---

<!doctype html>
<html lang="hi" class="h-full bg-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>2FA सत्यापन | हरियाणा न्यूज़ एडमिन</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-slate-950 font-devanagari text-slate-100 flex items-center justify-center p-4 selection:bg-brand-saffron selection:text-white">
    <div class="w-full max-w-md">
      <!-- Header -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-brand-saffron mb-3">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-white">दो-चरणीय प्रमाणीकरण (2FA)</h1>
        <p class="text-sm text-slate-400 mt-1">
          अपने Google Authenticator या Authy ऐप से 6 अंकों का कोड दर्ज करें
        </p>
      </div>

      <!-- Card -->
      <div class="bg-slate-800/80 backdrop-blur-xl border border-slate-700/60 rounded-2xl p-6 md:p-8 shadow-2xl relative overflow-hidden">
        <form id="mfa-verify-form" class="space-y-6">
          <!-- Alert Box -->
          <div id="error-alert" class="hidden p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm flex items-start gap-2">
            <svg class="w-5 h-5 shrink-0 text-red-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span id="error-text">त्रुटि संदेश</span>
          </div>

          <div>
            <label for="code" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 text-center mb-2">
              6-अंकीय TOTP कोड
            </label>
            <input
              type="text"
              id="code"
              name="code"
              required
              maxlength="6"
              pattern="[0-9]{6}"
              inputmode="numeric"
              autocomplete="one-time-code"
              placeholder="000000"
              autofocus
              class="w-full text-center text-3xl font-mono tracking-[0.5em] px-4 py-3 rounded-xl bg-slate-900/90 border border-slate-700 text-brand-saffron placeholder-slate-600 focus:outline-none focus:border-brand-saffron focus:ring-1 focus:ring-brand-saffron transition-all font-bold"
            />
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-brand-saffron to-amber-600 hover:from-amber-500 hover:to-brand-saffron text-white font-semibold text-sm shadow-lg shadow-brand-saffron/20 transition-all flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50"
          >
            <span id="btn-text">सत्यापित करें एवं डैशबोर्ड खोलें</span>
            <svg id="btn-spinner" class="hidden animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>
        </form>

        <div class="mt-6 pt-5 border-t border-slate-700/60 flex items-center justify-between text-xs">
          <a href="/admin/mfa-setup" class="text-brand-saffron hover:underline">
            नया 2FA सेट करें / QR कोड देखें
          </a>
          <a href="/api/admin/auth/logout" class="text-slate-400 hover:text-red-400 transition-colors">
            लॉगआउट
          </a>
        </div>
      </div>
    </div>

    <script is:inline>
      const form = document.getElementById('mfa-verify-form');
      const errorAlert = document.getElementById('error-alert');
      const errorText = document.getElementById('error-text');
      const submitBtn = document.getElementById('submit-btn');
      const btnText = document.getElementById('btn-text');
      const btnSpinner = document.getElementById('btn-spinner');
      const codeInput = document.getElementById('code');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorAlert?.classList.add('hidden');

        const code = codeInput?.value.trim();
        if (!code || code.length !== 6) {
          if (errorText) errorText.textContent = 'कृपया 6 अंकों का कोड दर्ज करें';
          errorAlert?.classList.remove('hidden');
          return;
        }

        submitBtn.disabled = true;
        btnText.textContent = 'सत्यापन जारी...';
        btnSpinner?.classList.remove('hidden');

        try {
          const res = await fetch('/api/admin/auth/verify-mfa', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code }),
          });

          const data = await res.json();

          if (!res.ok || !data.success) {
            if (data.needsSetup) {
              window.location.href = '/admin/mfa-setup';
              return;
            }
            throw new Error(data.error || 'सत्यापन विफल रहा');
          }

          window.location.href = data.redirect || '/admin';
        } catch (err) {
          if (errorText) errorText.textContent = err.message || 'सत्यापन त्रुटि';
          errorAlert?.classList.remove('hidden');
          codeInput.value = '';
          codeInput.focus();
        } finally {
          submitBtn.disabled = false;
          btnText.textContent = 'सत्यापित करें एवं डैशबोर्ड खोलें';
          btnSpinner?.classList.add('hidden');
        }
      });
    </script>
  </body>
</html>
