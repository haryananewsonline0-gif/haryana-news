---
// ==============================================================================
// Admin Login Page
// Route: /admin/login (noindex, nofollow, protected)
// ==============================================================================

import { verifyAdminSession } from '@/lib/auth/session';

export const prerender = false;

const runtimeEnv = Astro.locals?.runtime?.env;
const session = await verifyAdminSession(Astro.cookies, runtimeEnv);

if (session.isAuthenticated && session.isAdmin) {
  if (session.isMfaVerified) {
    return Astro.redirect('/admin');
  } else {
    return Astro.redirect('/admin/mfa');
  }
}

const turnstileSiteKey =
  runtimeEnv?.PUBLIC_TURNSTILE_SITE_KEY ||
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ||
  '1x00000000000000000000AA'; // Cloudflare test key for local/preview
---

<!doctype html>
<html lang="hi" class="h-full bg-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>एडमिन लॉगिन | हरियाणा न्यूज़</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </head>
  <body class="h-full font-devanagari text-slate-100 flex items-center justify-center p-4 selection:bg-brand-saffron selection:text-white">
    <div class="w-full max-w-md">
      <!-- Logo & Brand Header -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-tr from-brand-saffron via-white to-brand-green p-1 shadow-lg shadow-brand-saffron/20 mb-3">
          <div class="w-full h-full bg-slate-900 rounded-[14px] flex items-center justify-center">
            <span class="text-2xl font-black text-brand-saffron font-outfit">HN</span>
          </div>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-white">हरियाणा न्यूज़ एडमिन</h1>
        <p class="text-sm text-slate-400 mt-1">सुरक्षित संपादकीय नियंत्रण कक्ष</p>
      </div>

      <!-- Login Card -->
      <div class="bg-slate-800/80 backdrop-blur-xl border border-slate-700/60 rounded-2xl p-6 md:p-8 shadow-2xl relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand-saffron via-white to-brand-green"></div>

        <form id="admin-login-form" class="space-y-5">
          <!-- Alert Box -->
          <div id="error-alert" class="hidden p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm flex items-start gap-2">
            <svg class="w-5 h-5 shrink-0 text-red-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span id="error-text">त्रुटि संदेश</span>
          </div>

          <!-- Email Field -->
          <div>
            <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
              एडमिन ईमेल
            </label>
            <div class="relative">
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="admin@haryananews.online"
                class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-brand-saffron focus:ring-1 focus:ring-brand-saffron transition-all"
              />
            </div>
          </div>

          <!-- Password Field -->
          <div>
            <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
              पासवर्ड
            </label>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                autocomplete="current-password"
                placeholder="••••••••••••"
                class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-brand-saffron focus:ring-1 focus:ring-brand-saffron transition-all font-outfit"
              />
            </div>
          </div>

          <!-- Cloudflare Turnstile Widget -->
          <div class="flex justify-center my-2">
            <div
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-theme="dark"
              data-callback="onTurnstileSuccess"
              data-expired-callback="onTurnstileExpired"
            ></div>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-brand-saffron to-amber-600 hover:from-amber-500 hover:to-brand-saffron text-white font-semibold text-sm shadow-lg shadow-brand-saffron/20 transition-all flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
          >
            <span id="btn-text">लॉगिन करें</span>
            <svg id="btn-spinner" class="hidden animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>
        </form>

        <div class="mt-6 pt-5 border-t border-slate-700/60 text-center">
          <p class="text-xs text-slate-500">
            सुरक्षा प्रोटोकॉल: 5 विफल प्रयासों के बाद IP ब्लॉक • TOTP 2FA अनिवार्य
          </p>
        </div>
      </div>
    </div>

    <script is:inline>
      let turnstileToken = '';

      window.onTurnstileSuccess = function(token) {
        turnstileToken = token;
      };

      window.onTurnstileExpired = function() {
        turnstileToken = '';
      };

      const form = document.getElementById('admin-login-form');
      const errorAlert = document.getElementById('error-alert');
      const errorText = document.getElementById('error-text');
      const submitBtn = document.getElementById('submit-btn');
      const btnText = document.getElementById('btn-text');
      const btnSpinner = document.getElementById('btn-spinner');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorAlert?.classList.add('hidden');

        const email = document.getElementById('email')?.value;
        const password = document.getElementById('password')?.value;

        // Visual loading
        submitBtn.disabled = true;
        btnText.textContent = 'प्रमाणीकरण जारी...';
        btnSpinner?.classList.remove('hidden');

        try {
          const res = await fetch('/api/admin/auth/login', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              email,
              password,
              turnstileToken,
            }),
          });

          const data = await res.json();

          if (!res.ok || !data.success) {
            throw new Error(data.error || 'लॉगिन विफल रहा');
          }

          // Redirect to MFA screen
          window.location.href = data.redirect || '/admin/mfa';
        } catch (err) {
          if (errorText) errorText.textContent = err.message || 'लॉगिन में त्रुटि हुई';
          errorAlert?.classList.remove('hidden');

          // Reset Cloudflare turnstile if available
          if (window.turnstile) {
            window.turnstile.reset();
            turnstileToken = '';
          }
        } finally {
          submitBtn.disabled = false;
          btnText.textContent = 'लॉगिन करें';
          btnSpinner?.classList.add('hidden');
        }
      });
    </script>
  </body>
</html>
