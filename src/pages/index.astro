---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedArticles } from '@/lib/supabase/server';

export const prerender = false; // SSR

const runtimeEnv = Astro.locals?.runtime?.env;
const latestArticles = await getPublishedArticles({
  limit: 10,
  runtimeEnv,
});
---

<BaseLayout
  title="हरियाणा न्यूज़ | haryananews.online — ब्रेकिंग व ताज़ा समाचार"
  description="हरियाणा, सिरसा, फतेहाबाद, हिसार मंडी भाव, मौसम, सरकारी योजनाएं व खेल की ताज़ा खबरें।"
>
  <!-- Breaking News Ticker Skeleton -->
  <div class="mb-6 bg-white border-l-4 border-saffron rounded-r-lg shadow-sm p-3 flex items-center gap-3">
    <span class="bg-saffron text-white text-xs font-bold px-2 py-1 rounded">
      ब्रेकिंग न्यूज़
    </span>
    <p class="text-xs sm:text-sm text-zinc-700 font-medium truncate">
      हरियाणा न्यूज़ पोर्टल पर आपका स्वागत है — निष्पक्ष और सटीक खबरें सीधे आप तक।
    </p>
  </div>

  <!-- Hero Welcome / Showcase Banner -->
  <section class="bg-gradient-to-r from-saffron/10 via-amber-50 to-deepgreen/10 border border-saffron/20 rounded-2xl p-6 sm:p-8 mb-8 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm">
    <div class="space-y-2 max-w-xl">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-deepgreen/10 text-deepgreen text-xs font-bold">
        <span>✓ haryananews.online</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-zinc-950 tracking-tight leading-tight">
        हरियाणा की हर खबर, <span class="text-saffron">सबसे तेज़</span> और <span class="text-deepgreen">सटीक</span>
      </h1>
      <p class="text-sm text-zinc-600 leading-relaxed">
        सिरसा, फतेहाबाद, हिसार, आदमपुर, ऐलनाबाद, नोहर सहित पूरे हरियाणा की राजनीति, मंडी भाव, मौसम पूर्वानुमान और सरकारी योजनाओं की विश्वसनीय कवरेज।
      </p>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-2 gap-3 w-full sm:w-auto text-left">
      <a href="/category/mandi-bhav" class="bg-white p-3 rounded-xl border border-zinc-200/80 hover:border-saffron shadow-xs transition-colors">
        <span class="text-[11px] text-zinc-500 block">आज के भाव</span>
        <strong class="text-sm text-zinc-900 block font-bold">मंडी भाव अपडेट</strong>
      </a>
      <a href="/category/weather" class="bg-white p-3 rounded-xl border border-zinc-200/80 hover:border-deepgreen shadow-xs transition-colors">
        <span class="text-[11px] text-zinc-500 block">Open-Meteo</span>
        <strong class="text-sm text-zinc-900 block font-bold">जिलावार मौसम</strong>
      </a>
      <a href="/category/panchang" class="bg-white p-3 rounded-xl border border-zinc-200/80 hover:border-saffron shadow-xs transition-colors">
        <span class="text-[11px] text-zinc-500 block">दैनिक पंचांग</span>
        <strong class="text-sm text-zinc-900 block font-bold">राशिफल व मुहूर्त</strong>
      </a>
      <a href="/category/govt-jobs" class="bg-white p-3 rounded-xl border border-zinc-200/80 hover:border-deepgreen shadow-xs transition-colors">
        <span class="text-[11px] text-zinc-500 block">HSSC / पुलिस</span>
        <strong class="text-sm text-zinc-900 block font-bold">सरकारी भर्तियां</strong>
      </a>
    </div>
  </section>

  <!-- News Stream Section -->
  <section class="space-y-4">
    <div class="flex items-center justify-between border-b-2 border-zinc-200 pb-2">
      <h2 class="text-xl font-bold text-zinc-950 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-saffron"></span>
        ताज़ा खबरें
      </h2>
      <span class="text-xs text-zinc-500">24x7 ऑटो अपडेट</span>
    </div>

    {latestArticles.length === 0 ? (
      <div class="bg-white rounded-xl border border-zinc-200 p-12 text-center space-y-3">
        <div class="w-12 h-12 mx-auto rounded-full bg-saffron/10 flex items-center justify-center text-saffron">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-zinc-800">समाचार फीड तैयार हो रही है</h3>
        <p class="text-xs text-zinc-500 max-w-md mx-auto leading-relaxed">
          ऑटोमेशन पाइपलाइन और सुपबेस माइग्रेशन सेटअप पूर्ण होने के पश्चात शेड्यूल के अनुसार समाचार प्रकाशित होंगे।
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestArticles.map((article) => (
          <article class="bg-white rounded-xl border border-zinc-200 overflow-hidden shadow-xs hover:shadow-md transition-shadow">
            <img
              src={article.thumbnail_url}
              alt={article.image_alt || article.title}
              class="w-full h-48 object-cover"
              loading="lazy"
            />
            <div class="p-4 space-y-2">
              <span class="text-[11px] font-bold text-saffron uppercase tracking-wider">{article.category}</span>
              <h3 class="text-base font-bold text-zinc-900 leading-snug line-clamp-2">
                <a href={`/news/${article.slug}`} class="hover:text-saffron transition-colors">
                  {article.title}
                </a>
              </h3>
              <p class="text-xs text-zinc-600 line-clamp-2">{article.summary}</p>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
