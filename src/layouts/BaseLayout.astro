---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: string;
  canonicalUrl?: string;
  isArticle?: boolean;
}

const {
  title = 'हरियाणा न्यूज़ | haryananews.online — हरियाणा की ताज़ा व निष्पक्ष खबरें',
  description = 'हरियाणा, सिरसा, फतेहाबाद, हिसार, मंडी भाव, मौसम, सरकारी योजनाएं, खेल व राजनीति की सबसे तेज और सटीक खबरें।',
  image = '/images/og-default.jpg',
  articleDate,
  canonicalUrl = Astro.url.href,
  isArticle = false,
} = Astro.props;

// Format current date in Hindi IST
const todayFormatted = new Intl.DateTimeFormat('hi-IN', {
  timeZone: 'Asia/Kolkata',
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date());

const categories = [
  { slug: 'haryana', name: 'हरियाणा' },
  { slug: 'regional', name: 'क्षेत्रीय' },
  { slug: 'mandi-bhav', name: 'मंडी भाव' },
  { slug: 'weather', name: 'मौसम' },
  { slug: 'panchang', name: 'पंचांग/राशिफल' },
  { slug: 'govt-schemes', name: 'सरकारी योजनाएं' },
  { slug: 'govt-jobs', name: 'नौकरियां' },
  { slug: 'sports', name: 'खेल' },
  { slug: 'business', name: 'बाजार भाव' },
];
---

<!doctype html>
<html lang="hi" dir="ltr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="hi_IN" />
    <meta property="og:site_name" content="हरियाणा न्यूज़" />
    {isArticle && articleDate && (
      <meta property="article:published_time" content={articleDate} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#FAF8F5] text-zinc-900 min-h-screen flex flex-col font-hindi">
    <!-- Top Tricolor Border Accent -->
    <div class="h-1.5 w-full flex">
      <div class="h-full w-1/2 bg-saffron"></div>
      <div class="h-full w-1/2 bg-deepgreen"></div>
    </div>

    <!-- Top Utility Bar (Date, Tagline, Fast Links) -->
    <div class="bg-zinc-900 text-zinc-200 text-xs py-1.5 px-4 border-b border-zinc-800">
      <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-saffron animate-pulse"></span>
          <span>{todayFormatted} (IST)</span>
        </div>
        <div class="hidden sm:flex items-center gap-4 text-zinc-400">
          <span>haryananews.online — हरियाणा की आवाज़</span>
          <a href="/weather" class="hover:text-saffron transition-colors">मौसम</a>
          <a href="/mandi-bhav" class="hover:text-saffron transition-colors">मंडी भाव</a>
          <a href="/panchang" class="hover:text-saffron transition-colors">पंचांग</a>
        </div>
      </div>
    </div>

    <!-- Main Header -->
    <header class="bg-white border-b border-zinc-200 sticky top-0 z-40 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-lg bg-gradient-to-tr from-saffron to-amber-500 flex items-center justify-center text-white font-extrabold text-2xl shadow-md shadow-saffron/20 group-hover:scale-105 transition-transform">
            ह
          </div>
          <div class="flex flex-col">
            <span class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-950 group-hover:text-saffron transition-colors">
              हरियाणा <span class="text-deepgreen">न्यूज़</span>
            </span>
            <span class="text-[10px] tracking-wider uppercase text-zinc-500 font-medium -mt-1">
              Haryana News • haryananews.online
            </span>
          </div>
        </a>

        <!-- Right Quick Actions -->
        <div class="flex items-center gap-3">
          <a
            href="/search"
            class="p-2 text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 rounded-lg transition-colors"
            title="सर्च करें"
            aria-label="खोजें"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </a>
          <a
            href="https://chat.whatsapp.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-deepgreen text-white text-xs font-semibold hover:bg-deepgreen-600 transition-colors shadow-sm"
          >
            <span>WhatsApp ग्रुप</span>
          </a>
        </div>
      </div>

      <!-- Category Navigation Bar -->
      <nav class="border-t border-zinc-100 bg-white overflow-x-auto scrollbar-none">
        <div class="max-w-7xl mx-auto px-4 flex items-center gap-1 whitespace-nowrap text-sm font-semibold">
          <a
            href="/"
            class="py-2.5 px-3 text-zinc-800 hover:text-saffron border-b-2 border-transparent hover:border-saffron transition-colors"
          >
            होम
          </a>
          {categories.map((cat) => (
            <a
              href={`/category/${cat.slug}`}
              class="py-2.5 px-3 text-zinc-700 hover:text-saffron border-b-2 border-transparent hover:border-saffron transition-colors"
            >
              {cat.name}
            </a>
          ))}
        </div>
      </nav>
    </header>

    <!-- Main Content Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-6">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-zinc-950 text-zinc-300 border-t-4 border-saffron mt-12">
      <div class="max-w-7xl mx-auto px-4 py-10">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <!-- Col 1: About -->
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded bg-saffron flex items-center justify-center text-white font-bold text-lg">ह</div>
              <span class="text-xl font-bold text-white">हरियाणा न्यूज़</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed">
              haryananews.online हरियाणा का विश्वसनीय डिजिटल हिंदी समाचार पोर्टल है। हमारा उद्देश्य निष्पक्ष, सटीक और जनहित की खबरें सबसे पहले आप तक पहुंचाना है।
            </p>
          </div>

          <!-- Col 2: Categories -->
          <div>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-3">प्रमुख श्रेणियां</h3>
            <ul class="space-y-2 text-xs">
              <li><a href="/category/haryana" class="hover:text-saffron transition-colors">हरियाणा मुख्य खबरें</a></li>
              <li><a href="/category/mandi-bhav" class="hover:text-saffron transition-colors">सिरसा व आदमपुर मंडी भाव</a></li>
              <li><a href="/category/weather" class="hover:text-saffron transition-colors">हरियाणा मौसम रिपोर्ट</a></li>
              <li><a href="/category/govt-jobs" class="hover:text-saffron transition-colors">HSSC व सरकारी नौकरी</a></li>
              <li><a href="/category/panchang" class="hover:text-saffron transition-colors">दैनिक राशिफल व पंचांग</a></li>
            </ul>
          </div>

          <!-- Col 3: Districts -->
          <div>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-3">क्षेत्रीय कवरेज</h3>
            <div class="flex flex-wrap gap-1.5 text-xs">
              <a href="/district/sirsa" class="px-2 py-1 bg-zinc-900 hover:bg-saffron hover:text-zinc-950 rounded transition-colors">सिरसा</a>
              <a href="/district/fatehabad" class="px-2 py-1 bg-zinc-900 hover:bg-saffron hover:text-zinc-950 rounded transition-colors">फतेहाबाद</a>
              <a href="/district/hisar" class="px-2 py-1 bg-zinc-900 hover:bg-saffron hover:text-zinc-950 rounded transition-colors">हिसार</a>
              <a href="/district/adampur" class="px-2 py-1 bg-zinc-900 hover:bg-saffron hover:text-zinc-950 rounded transition-colors">आदमपुर</a>
              <a href="/district/ellenabad" class="px-2 py-1 bg-zinc-900 hover:bg-saffron hover:text-zinc-950 rounded transition-colors">ऐलनाबाद</a>
              <a href="/district/nohar" class="px-2 py-1 bg-zinc-900 hover:bg-saffron hover:text-zinc-950 rounded transition-colors">नोहर</a>
              <a href="/district/bhadra" class="px-2 py-1 bg-zinc-900 hover:bg-saffron hover:text-zinc-950 rounded transition-colors">भादरा</a>
            </div>
          </div>

          <!-- Col 4: Legal & Policy (AdSense Ready) -->
          <div>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-3">महत्वपूर्ण नीतियां</h3>
            <ul class="space-y-2 text-xs">
              <li><a href="/about" class="hover:text-saffron transition-colors">हमारे बारे में (About Us)</a></li>
              <li><a href="/contact" class="hover:text-saffron transition-colors">संपर्क करें (Contact Us)</a></li>
              <li><a href="/privacy-policy" class="hover:text-saffron transition-colors">गोपनीयता नीति (Privacy Policy)</a></li>
              <li><a href="/disclaimer" class="hover:text-saffron transition-colors">अस्वीकरण (Disclaimer)</a></li>
              <li><a href="/terms" class="hover:text-saffron transition-colors">नियम व शर्तें (Terms & Conditions)</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-zinc-800 pt-6 text-center text-xs text-zinc-500">
          <p>© {new Date().getFullYear()} Haryana News (haryananews.online). सर्वाधिकार सुरक्षित।</p>
          <p class="mt-1 text-[11px] text-zinc-600">
            साइट पर प्रकाशित एआई-जनित चित्रों पर "प्रतीकात्मक तस्वीर (AI)" का सांकेतिक लेबल प्रयुक्त होता है।
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
